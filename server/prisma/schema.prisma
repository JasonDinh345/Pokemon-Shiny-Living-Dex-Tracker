generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model caught_shinies {
  pokemon_name String    @db.VarChar(50)
  user_email   String    @db.VarChar(255)
  method       String    @db.VarChar(50)
  nickname     String?   @db.VarChar(50)
  hunt_started DateTime? @db.Date
  date_caught  DateTime? @db.Date
  encounters   Int?
  id           Int       @id @default(autoincrement())
  game         String    @db.VarChar(50)
  users        users     @relation(fields: [user_email], references: [email], onDelete: Cascade, map: "user_email_foreign2")

  @@index([user_email], map: "user_email_foreign2")
}

model users {
  username       String           @db.VarChar(255)
  email          String           @id @db.VarChar(255)
  password       String?          @db.VarChar(255)
  verified       Boolean          @default(false)
  googleID       String?          @unique(map: "googleID") @db.VarChar(255)
  caught_shinies caught_shinies[]
  tokens         tokens[]
}

model tokens {
  token      String      @unique(map: "token") @db.VarChar(255)
  expires_on DateTime    @db.Date
  user_email String      @db.VarChar(255)
  type       tokens_type
  users      users       @relation(fields: [user_email], references: [email], onDelete: Cascade, map: "user_email_foreign3")

  @@id([user_email, type])
}

enum tokens_type {
  EMAIL_VERIFICATION
  RESET_PASS
  REFRESH
}
